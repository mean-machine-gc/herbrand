{
  "name": "herbrand-ui",
  "version": "0.2.2",
  "description": "Herbrand UI — visual companion for decision-first business analysis",
  "type": "module",
  "bin": {
    "herbrand-ui": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "vendor/",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "vendor": "rm -rf vendor && mkdir -p vendor && cp -r ../../packages/core/src vendor/src && cp ../../packages/core/package.json vendor/package.json",
    "prepublishOnly": "npm run vendor"
  },
  "dependencies": {
    "@herbrand/core": "*",
    "@dagrejs/dagre": "^1.1.4",
    "@preact/signals-core": "^1.14.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-react": "^4.5.0",
    "@xyflow/react": "^12.10.0",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-components": "^1.5.4",
    "graphology-dag": "^0.4.1",
    "graphology-metrics": "^2.4.0",
    "graphology-shortest-path": "^2.1.0",
    "graphology-traversal": "^0.3.1",
    "graphology-types": "^0.24.8",
    "lucide-react": "^1.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "vite": "^6.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  },
  "keywords": ["herbrand", "business-analysis", "decision-modelling", "ui", "vite"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mean-machine-gc/herbrand"
  }
}
