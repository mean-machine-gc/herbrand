{
  "name": "herbrand-ui",
  "version": "0.1.0",
  "description": "Herbrand UI — visual companion for decision-first business analysis",
  "type": "module",
  "bin": {
    "herbrand-ui": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "vendor/",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "vendor": "tsup ../../packages/signals/src/index.ts --format esm --outDir vendor --no-dts --external @preact/signals-core",
    "prepublishOnly": "npm run vendor"
  },
  "dependencies": {
    "@mantine/core": "^7.17.0",
    "@mantine/hooks": "^7.17.0",
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.10.0",
    "@preact/signals-core": "^1.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "fast-glob": "^3.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "keywords": ["herbrand", "business-analysis", "decision-modelling", "ui", "vite"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mean-machine-gc/herbrand"
  },
  "homepage": "https://github.com/mean-machine-gc/herbrand",
  "bugs": {
    "url": "https://github.com/mean-machine-gc/herbrand/issues"
  }
}
